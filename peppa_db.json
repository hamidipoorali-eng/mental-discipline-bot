# Build unique clips per episode from nodes + episode_highlights
ep_clips = {i: {} for i in range(1, 7)}

for node in old_db["nodes"]:
    topic = node["title"]
    context_tag = node["context_tag"]
    parenting = node["parenting_example"]
    pattern_label = " / ".join(node["patterns"][:2])
    for occ in node["occurrences"]:
        ep = occ["episode"]
        aud = occ["audio"]
        if aud not in ep_clips[ep]:
            st, en = clip_times.get(aud, ("", ""))
            ep_clips[ep][aud] = {
                "audio": aud,
                "start": st,
                "end": en,
                "speaker": occ["speaker"],
                "topic": topic,
                "context_tag": context_tag,
                "pattern": pattern_label,
                "text": occ["text"],
                "fa_meaning": occ.get("visual_anchor", ""),
                "shadowing": occ["shadowing"],
                "phonetic_note": occ["phonetic_note"],
                "parenting_example": parenting
            }

# Merge episode_highlights (e.g., ep6 golden sentences) with rich fa_meaning
ep6_topic_map = {
    "ep6_01.mp3": ("هیجان و اشتیاق", "بازی و هیجان"),
    "ep6_04.mp3": ("همراهی و همدلی", "محبت و تشویق"),
    "ep6_08.mp3": ("تحسین و تشویق", "محبت و تشویق"),
    "ep6_11.mp3": ("آموزش و یاد دادن", "راهنمایی و کنجکاوی"),
    "ep6_15.mp3": ("تشویق به نمایش مهارت", "محبت و تشویق"),
}

for hl in old_db.get("episode_highlights", []):
    ep = hl["episode"]
    for s in hl.get("sentences", []):
        aud = s["audio"]
        topic, ctx = ep6_topic_map.get(aud, ("ساختارهای کلیدی", "محبت و تشویق"))
        ep_clips[ep][aud] = {
            "audio": aud,
            "start": "",
            "end": "",
            "speaker": s["speaker"],
            "topic": topic,
            "context_tag": ctx,
            "pattern": s["pattern"],
            "text": s["text"],
            "fa_meaning": s["fa_meaning"],
            "shadowing": s["shadowing"],
            "phonetic_note": s["phonetic_note"],
            "parenting_example": s["parenting_example"]
        }

# Sort clips chronologically by audio filename inside each episode
peppa_db = {
    "meta": {
        "title": "Peppa Pig 36-Day Structured Learning Database",
        "accent": "British English (UK)",
        "audio_spec": "MP3, 64kbps, Mono"
    },
    "episodes": []
}

for ep_meta in old_db["episodes"]:
    ep_id = ep_meta["id"]
    sorted_clips = [ep_clips[ep_id][k] for k in sorted(ep_clips[ep_id].keys())]
    peppa_db["episodes"].append({
        "id": ep_id,
        "title": ep_meta["title"],
        "fa_title": ep_meta["fa_title"],
        "full_audio": f"ep{ep_id}_full.mp3",
        "clips": sorted_clips
    })

with open('peppa_db.json', 'w', encoding='utf-8') as f:
    json.dump(peppa_db, f, ensure_ascii=False, indent=2)

for ep in peppa_db["episodes"]:
    print(f"Ep {ep['id']} ({ep['title']}): {len(ep['clips'])} clips")
